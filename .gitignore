# Vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist
*~

# Logs
scripts/*.log
/*.log

# Misc archives
/*\.deb
/*\.zip
/*\.tar
/*\.tar\.*

# Upstream package definitions, fetched by scripts/setup-upstream.sh. The
# placeholder is committed so the committed symlinks never dangle: a dangling
# link makes scripts/buildorder.py die with a bare FileNotFoundError, whereas an
# empty directory produces its actual "depends on non-existing package" message.
.upstream-packages/*
!/.upstream-packages/.gitkeep

# Source files.
/sources/

# GitHub Actions build artifacts
debs*
checksum*

# Built *.deb files.
/debs/
/output/

# Preinstalled build tools.
/build-tools/

# Predownloaded packages sources.
/packages/*/cache
/root-packages/*/cache
/x11-packages/*/cache

# Temp .git directories for packages built from local sources "file://"
/*.git

# Generated by scripts/check-repository-health.sh
scripts/apt-packages-list-*.txt

# Generated on GitHub Actions CI when building kernel modules
/scripts/*.ko.zst
